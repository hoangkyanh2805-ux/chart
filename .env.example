# Biến môi trường mẫu cho dự án ChartAnimator
NEXT_PUBLIC_APP_NAME="ChartAnimator Studio"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 9Router Config (Local FREE AI Model Router & Gateway)
# Bật 9router: gõ `9router` trong terminal -> mở http://localhost:20128
USE_9ROUTER=true
NINE_ROUTER_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=9router
NINE_ROUTER_MODEL=kr/claude-sonnet-4.5

# OpenRouter AI (Tùy chọn thay thế nếu có trả phí)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-70b

# Google Gemini API (Tùy chọn thay thế)
GEMINI_API_KEY=

# LearnHouse LMS API Config (Azzam Academy)
LEARNHOUSE_API_TOKEN=
LEARNHOUSE_BASE_URL=https://learn.azzamedu.com
LEARNHOUSE_ORG_SLUG=alpha-elite

# Google AI Studio Gemini TTS Config
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_DEFAULT_VOICE=Charon
